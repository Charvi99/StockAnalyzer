# Polygon.io API Configuration
# Get your free API key at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# ── Ledger health alerts (Phase 1.11) ─────────────────────────────────────────
# Optional. The check_ledger_health task ALWAYS logs (visible in `docker logs` +
# Flower); it pushes to a webhook and/or email ONLY when the relevant vars are set.
# Leave all unset for log-only operation.
#
# Webhook (Slack / Discord / generic incoming webhook):
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_WEBHOOK_FORMAT=slack   # 'slack' posts {"text":...}; 'discord' posts {"content":...}
#
# Email (SMTP STARTTLS — e.g. a Gmail app-password or SendGrid):
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=you@example.com
# ALERT_SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_FROM=you@example.com
# ALERT_EMAIL_TO=you@example.com
